# 复制成 .env 后填写：cp .env.example .env && chmod 600 .env
# .env 已在 .gitignore 里，永远不要提交

# DeepSeek（只在服务端使用，不会下发到浏览器）
DEEPSEEK_API_KEY=

# 日常模式的网页搜索：不配就走免密钥的 Bing RSS；
# 要换 Tavily / Serper / Bing API 时填 provider 与对应密钥（只留在服务端）
# SEARCH_PROVIDER=tavily
# SEARCH_API_KEY=

# PostgreSQL + pgvector（docker compose 的 db 服务）
POSTGRES_USER=rag
# 生成一个随机密码，例如 python3 -c "import secrets;print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
POSTGRES_DB=rag
# 不跑 compose、直接连本机数据库时用；不设置则退回内存索引（仅适合开发/单测）
# DATABASE_URL=postgresql://rag:password@127.0.0.1:5432/rag

# 检索
KB_MODE=hybrid-ce
KB_FUSE_K=10

# 应答缓存：同一问题的已作答回答复用多久（秒）；0 = 关闭
# 只缓存作答成功的回答，拒答不入缓存；语料/模式/provider 变化后自动换键
KB_CACHE_TTL=86400

# 回答反馈：有 DATABASE_URL 时写 answer_feedback 表；
# 没有数据库（或写库失败）时退到这个 JSONL，避免丢掉用户的操作
KB_FEEDBACK_LOG=data/work/feedback.jsonl

# 访问控制：生成一个随机口令，例如 python3 -c "import secrets;print(secrets.token_urlsafe(24))"
KB_ACCESS_TOKEN=
# 每个 IP 在 KB_RATE_WINDOW 秒内最多 KB_RATE_MAX 次
KB_RATE_MAX=20
KB_RATE_WINDOW=600
# 全局每日上限，0 = 不限；用来给 DeepSeek 账单封顶
KB_DAILY_MAX=200
